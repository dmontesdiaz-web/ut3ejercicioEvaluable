<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".activity_ejercicio5">

    <TextView
        android:id="@+id/txtPantalla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@color/white"
        android:gravity="end"
        android:maxLines="1"
        android:padding="16dp"
        android:text="0"
        android:textColor="@color/black"
        android:textSize="48sp" />

    <TableLayout
        android:id="@+id/tablaBotones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:stretchColumns="*">
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btnC"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:layout_span="4"
                android:text="C"
                android:textSize="28sp"
                app:backgroundTint="#B71C1C" />
        </TableRow>
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btn7"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="7"
                android:textSize="28sp"
                app:backgroundTint="@color/blue" />
            <Button
                android:id="@+id/btn8"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="8"
                android:textSize="28sp"
                app:backgroundTint="@color/blue" />
            <Button
                android:id="@+id/btn9"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="9"
                android:textSize="28sp"
                app:backgroundTint="@color/blue" />
            <Button
                android:id="@+id/btnDividir"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="/"
                android:textSize="28sp"
                app:backgroundTint="#F57C00" />
        </TableRow>
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btn4"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="4"
                android:textSize="28sp"
                app:backgroundTint="@color/blue" />
            <Button
                android:id="@+id/btn5"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="5"
                android:textSize="28sp"
                app:backgroundTint="@color/blue" />
            <Button
                android:id="@+id/btn6"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="6"
                android:textSize="28sp"
                app:backgroundTint="@color/blue" />
            <Button
                android:id="@+id/btnMultiplicar"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="*"
                android:textSize="28sp"
                app:backgroundTint="#F57C00" />
        </TableRow>
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btn1"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="1"
                android:textSize="28sp"
                app:backgroundTint="@color/blue" />
            <Button
                android:id="@+id/btn2"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="2"
                android:textSize="28sp"
                app:backgroundTint="@color/blue" />
            <Button
                android:id="@+id/btn3"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="3"
                android:textSize="28sp"
                app:backgroundTint="@color/blue" />
            <Button
                android:id="@+id/btnRestar"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="-"
                android:textSize="28sp"
                app:backgroundTint="#F57C00" />
        </TableRow>
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button
                android:id="@+id/btn0"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="0"
                android:textSize="28sp"
                app:backgroundTint="@color/blue" />
            <Button
                android:id="@+id/btnDecimal"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="."
                android:textSize="28sp"
                app:backgroundTint="@color/blue" />
            <Button
                android:id="@+id/btnIgual"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="="
                android:textSize="28sp"
                app:backgroundTint="#2E7D32" />
            <Button
                android:id="@+id/btnSumar"
                android:layout_height="match_parent"
                android:layout_margin="4dp"
                android:text="+"
                android:textSize="28sp"
                app:backgroundTint="#F57C00" />
        </TableRow>
    </TableLayout>

</LinearLayout>
